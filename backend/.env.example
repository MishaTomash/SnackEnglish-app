# Порт, на якому підіймається Express сервер
PORT=3000

# Рядок підключення до MongoDB Atlas або локальної бази
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/snackenglish?retryWrites=true&w=majority

# Токен вашого бота від @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Дозволений Origin для CORS (домен фронтенду або тунелю)
CLIENT_URL=https://your-app-domain.com

# Посилання на WebApp для генерації інлайн-кнопки в команді /start (обов'язково HTTPS)
VITE_APP_URL=https://your-app-domain.com

SPEECH_PROVIDER=groq     # безкоштовно, працює і в Telegram (рекомендую зараз)
SPEECH_PROVIDER=openai   # платно, коли поповниш рахунок
SPEECH_PROVIDER=browser  # безкоштовно, але лише Chrome/Edge; у Telegram не працює
SPEECH_PROVIDER=off      # голосові вправи лише пропускаються

NODE_ENV=production

OPENAI_API_KEY=sk-...