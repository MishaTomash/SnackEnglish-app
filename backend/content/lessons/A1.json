        "grammar": {
          "title": "Verb \"To Be\"",
          "explanation": "Дієслово \"to be\" (бути) змінюється залежно від займенника: I am, You are, He/She/It is, We/They are.",
          "examples": [
            { "en": "I am a student.", "ua": "Я студент." },
            { "en": "She is from Ukraine.", "ua": "Вона з України." },
            { "en": "They are very friendly.", "ua": "Вони дуже привітні." }
