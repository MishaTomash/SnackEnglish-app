# Режим роботи оточення (development | production)
VITE_APP_ENV=development

# Юзернейм вашого Telegram бота (без символу @)
VITE_BOT_USERNAME=your_bot_username

# Базовий URL клієнтського застосунку (WebApp)
VITE_APP_URL=https://your-app-domain.com

# Базовий URL для API бекенду
VITE_API_URL=http://localhost:3000/api

# Увімкнення локальних моків замість реального бекенду (true | false)
VITE_USE_MOCKS=false